* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html, body {
    width: 100%;
    height: 100%;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background-color: #0d1b2a;
    color: #ffffff;
}

.container {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.card {
    background: #1b263b;
    border-radius: 24px;
    padding: 32px 24px;
    text-align: center;
    max-width: 360px;
    width: 100%;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
    border: 1px solid #415a77;
}

.logo-wrapper {
    width: 120px;
    height: 120px;
    margin: 0 auto 20px auto;
}

.logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 22px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
}

.titulo {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 10px;
    color: #ffffff;
}

.descricao {
    font-size: 0.9rem;
    color: #e0e1dd;
    line-height: 1.45;
    margin-bottom: 24px;
}

.btn-instalar {
    background-color: #e63946;
    color: #ffffff;
    border: none;
    width: 100%;
    padding: 15px;
    font-size: 1rem;
    font-weight: 700;
    border-radius: 14px;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(230, 57, 70, 0.4);
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: background-color 0.2s, transform 0.1s;
}

.btn-instalar:active {
    transform: scale(0.98);
    background-color: #d62839;
}

.btn-web {
    display: inline-block;
    color: #778da9;
    text-decoration: none;
    font-size: 0.85rem;
    padding: 8px;
    transition: color 0.2s;
}

.btn-web:hover {
    color: #ffffff;
}

.instrucoes-ios {
    background: #0d1b2a;
    border: 1px solid #415a77;
    border-radius: 14px;
    padding: 14px;
    text-align: left;
    font-size: 0.85rem;
    color: #e0e1dd;
    margin-bottom: 16px;
}

.instrucoes-ios p {
    margin-bottom: 6px;
    color: #ffffff;
}

.instrucoes-ios ol {
    margin-left: 18px;
    line-height: 1.5;
}

.icone-share {
    color: #317efb;
    font-weight: bold;
}
